# Environment Configuration Template
# Copy to .env and fill in your values (never commit .env to git)

# Python paths
PYTHONPATH=.

# Data paths (local development)
DATA_DIR=./data
DBT_PROFILES_DIR=./dbt

# Databricks (if using Community Edition - fill after spike)
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
# DATABRICKS_CLUSTER_ID=

# MLflow (defaults to local tracking)
MLFLOW_TRACKING_URI=./mlruns
# MLFLOW_EXPERIMENT_NAME=nfl_pregame

# Feature flags
ENABLE_LIVE_FEED=false
