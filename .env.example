# Environment Configuration Template
# Copy to .env and fill in your values (never commit .env to git)

# Python paths
PYTHONPATH=.

# Data paths (local development)
DATA_DIR=./data
DBT_PROFILES_DIR=./dbt

# Databricks Free Edition configuration
# Required for: dbt build --target databricks, make ingest, make dbt-build-databricks
# Get these from SQL Warehouse > Connection details and Settings > Developer > Access tokens
# DATABRICKS_HOST=adb-xxxxx.xx.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxx
# DATABRICKS_TOKEN=dapi...
# Catalog and marts schema for DatabricksClient.
# dbt target databricks uses profile schema nfl_dev and models/marts +schema marts.
# With no generate_schema_name macro, dbt builds marts in nfl_dev_marts.
# DATABRICKS_CATALOG=workspace
# DATABRICKS_MARTS_SCHEMA=nfl_dev_marts

# MLflow
# Local tracking defaults to sqlite:///mlflow.db in the repo root.
# MLflow 3.16 refuses the file store. If an older .env still has
# MLFLOW_TRACKING_URI=./mlruns (or mlruns), change it to the sqlite URI below.
# Training logs a warning and uses sqlite:///mlflow.db for a plain local path.
# Uncomment to override (Databricks: MLFLOW_TRACKING_URI=databricks).
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_EXPERIMENT_NAME=nfl_pregame

# Feature flags
ENABLE_LIVE_FEED=false
