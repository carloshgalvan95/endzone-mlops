{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carloshgalvan95.github.io/endzone-mlops/contracts/site-data/v1/track_record.schema.json",
  "title": "Weekly track record",
  "description": "track_record.json. Rates use the earliest archived probabilities and the newest finals. Ties are counted and are left out of log loss. contract_version is optional on a file written before v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "available",
    "reason",
    "generated_at",
    "method",
    "method_url",
    "probability_clip",
    "small_sample_decided",
    "seasons"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "available": { "type": "boolean" },
    "reason": { "type": ["string", "null"] },
    "generated_at": { "$ref": "#/$defs/utcStamp" },
    "method": { "type": "string", "const": "ADR-008" },
    "method_url": {
      "type": "string",
      "const": "https://github.com/carloshgalvan95/endzone-mlops/blob/main/docs/adr/ADR-008-weekly-track-record.md"
    },
    "probability_clip": { "type": "number", "const": 0.000001 },
    "small_sample_decided": { "type": "integer", "const": 48 },
    "seasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/season" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "available": { "const": false } },
        "required": ["available"]
      },
      "then": {
        "properties": {
          "reason": { "const": "archive_unreachable" },
          "seasons": { "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "available": { "const": true } },
        "required": ["available"]
      },
      "then": {
        "properties": { "reason": { "type": "null" } }
      }
    }
  ],
  "$defs": {
    "utcStamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "rate": { "type": ["number", "null"] },
    "count": { "type": "integer", "minimum": 0 },
    "counts": {
      "type": "object",
      "required": [
        "games",
        "finished",
        "unfinished",
        "ties",
        "decided",
        "pick_hits",
        "pick_misses",
        "pick_unavailable",
        "tie_hits",
        "market_games",
        "market_missing",
        "score_games",
        "score_missing",
        "prediction_games_from_archive",
        "prediction_games_from_this_build"
      ],
      "properties": {
        "games": { "$ref": "#/$defs/count" },
        "finished": { "$ref": "#/$defs/count" },
        "unfinished": { "$ref": "#/$defs/count" },
        "ties": { "$ref": "#/$defs/count" },
        "decided": { "$ref": "#/$defs/count" },
        "pick_hits": { "$ref": "#/$defs/count" },
        "pick_misses": { "$ref": "#/$defs/count" },
        "pick_unavailable": { "$ref": "#/$defs/count" },
        "tie_hits": { "$ref": "#/$defs/count" },
        "market_games": { "$ref": "#/$defs/count" },
        "market_missing": { "$ref": "#/$defs/count" },
        "score_games": { "$ref": "#/$defs/count" },
        "score_missing": { "$ref": "#/$defs/count" },
        "prediction_games_from_archive": { "$ref": "#/$defs/count" },
        "prediction_games_from_this_build": { "$ref": "#/$defs/count" }
      }
    },
    "rates": {
      "type": "object",
      "required": ["model_log_loss", "market_log_loss", "margin_mae", "total_mae"],
      "properties": {
        "model_log_loss": { "$ref": "#/$defs/rate" },
        "market_log_loss": { "$ref": "#/$defs/rate" },
        "margin_mae": { "$ref": "#/$defs/rate" },
        "total_mae": { "$ref": "#/$defs/rate" }
      }
    },
    "week": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/counts" },
        { "$ref": "#/$defs/rates" },
        {
          "type": "object",
          "required": ["season", "week", "state"],
          "properties": {
            "season": { "type": "integer", "minimum": 1 },
            "week": { "type": "integer", "minimum": 1 },
            "state": { "type": "string", "enum": ["no_finals", "partial", "complete"] }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "unevaluatedProperties": false,
      "allOf": [
        { "$ref": "#/$defs/counts" },
        { "$ref": "#/$defs/rates" },
        {
          "type": "object",
          "required": ["weeks", "weeks_with_finals", "sample_label"],
          "properties": {
            "weeks": { "type": "integer", "minimum": 0 },
            "weeks_with_finals": { "type": "integer", "minimum": 0 },
            "sample_label": {
              "type": ["string", "null"],
              "enum": ["one_week", "small", "no_finals", null]
            }
          }
        }
      ]
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["season", "weeks", "summary"],
      "properties": {
        "season": { "type": "integer", "minimum": 1 },
        "weeks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/week" }
        },
        "summary": { "$ref": "#/$defs/summary" }
      }
    }
  }
}
