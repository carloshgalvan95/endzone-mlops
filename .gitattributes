# Normalize line endings across platforms
# See: https://git-scm.com/docs/gitattributes

# Auto detect text files and normalize to LF
* text=auto eol=lf

# Explicitly declare text files with LF endings
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
Makefile text eol=lf

# PowerShell scripts use CRLF (Windows native)
*.ps1 text eol=crlf

# Binary files
*.parquet binary
*.duckdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
