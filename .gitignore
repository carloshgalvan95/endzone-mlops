# Local CCDS data cache. Layout is tracked with .gitkeep.
# The Python package is endzone/data, not this folder.
data/*
!data/raw/
!data/interim/
!data/processed/
!data/external/
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
*.parquet
*.csv
!dbt/seeds/*.csv
*.json
!dbt/**/*.json
!.cursor/environment.json
!tests/golden/*.json
!docs/experiments/reference_metrics.json
# Frozen Sprint 2 CV JSON, committed only after a warehouse run. ADR-007.
!docs/experiments/reports/sprint2_cv_report.json
# Example slate and public team logo URLs. Real weekly JSON stays ignored.
# See ADR-006.
!site/data/sample.json
!site/data/teams.json

# Serialized local models. There is no endzone/models package.
models/*
!models/.gitkeep

# Local audit and CV scratch (make audit-features, make train-cv, make check-epa-filter).
# Frozen decision snapshots live in docs/experiments/reports/ and are committed.
# Training still writes reports/phase* and reports/epa_filter_check.md.
reports/*
!reports/figures/
reports/figures/*
!reports/figures/.gitkeep

