# dbt profiles configuration
# Copy to profiles.yml and fill in your credentials (never commit profiles.yml)

# Local development with DuckDB (Day 1 default)
endzone_mlops:
  target: local
  outputs:
    local:
      type: duckdb
      path: ./target/endzone_mlops.duckdb
      schema: main
      threads: 4

    # Databricks Free Edition (after spike succeeds)
    # Free Edition uses Unity Catalog by default
    databricks:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: workspace  # Unity Catalog (default workspace catalog in Free Edition)
      schema: nfl_dev     # Schema within the catalog
      threads: 4

    # Snowflake (Plan B if Databricks spike fails)
    snowflake:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE', 'SYSADMIN') }}"
      database: nfl_dev
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'COMPUTE_WH') }}"
      schema: public
      threads: 4
